import beep from "../beep.mp3"; // ✅ FIX PATH

useEffect(() => {
  socket.on("receive_text", (data) => {

    setWords(data);

    data.forEach(item => {
      if (item.bad) {
        const audio = new Audio(beep);
        audio.play(); // 🔊 BEEP
      }
    });

  });

  // ✅ CLEANUP (VERY IMPORTANT)
  return () => socket.off("receive_text");

}, []);